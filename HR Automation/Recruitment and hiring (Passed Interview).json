      "parameters": {
        "content": "## Shortlisted Candidate Trigger\n\n**Purpose:**  \nAutomatically detects the status of the interview.\n",
        "height": 384,
        "width": 272,
        "color": 3
      },
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -96,
