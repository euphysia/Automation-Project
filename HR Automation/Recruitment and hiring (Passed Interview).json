      "parameters": {
        "sendTo": "={{ $('Get Shortlisted Candidate').item.json.Email }}",
        "subject": "=Congratulations – Job Offer for {{ $('Get Shortlisted Candidate').item.json['Position '] }} at Lilac Grove Kindergarten",
        "message": "=<p>\n<img src=\"https://drive.google.com/uc?export=view&id=1ZsBGhPFwTZunY-ogkqEpwjzYEzfEjEA0\" alt=\"Lilac Grove Logo\" width=\"600\" height=\"115\" style=\"display: block; margin-top: 10px;\" />\n</p>\n\n<h2 style=\"color: #004aad;\">Job Offer – {{ $('Get Shortlisted Candidate').item.json['Position '] }}</h2>\n    \n    <p>Dear <strong>{{ $('Get Shortlisted Candidate').item.json['Full Name'] }}</strong>,</p>\n\n    <p>We are excited to offer you the position of <strong>{{ $('Get Shortlisted Candidate').item.json['Position '] }}</strong> at <strong>Lilac Grove Kindergarten</strong>.</p>\n\n    <p>It was a pleasure speaking with you during the interview process. Your skills, experience, and attitude stood out, and we believe you’ll make a great addition to our team.</p>\n\n    <p>Please find the offer letter attached with this email. It includes details about the role, and other relevant information. Take your time to review it carefully, and feel free to reach out if you have any questions.</p>\n\n    <p>While we encourage you to take the time you need to consider the offer, do note that the position may not remain available indefinitely as we continue with our hiring process.</p>\n\n    <p>We hope to hear from you soon and look forward to the possibility of welcoming you aboard!</p>\n\n    <p style=\"margin-top: 30px;\">Warm regards,</p>\n    <p><strong>Ruby</strong><br>\n    HR Team<br>\n    Lilac Grove Kindergarten</p>",
        "options": {
          "appendAttribution": false,
          "attachmentsUi": {
            "attachmentsBinary": [
              {}
            ]
          }
        }
