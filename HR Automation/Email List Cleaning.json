    {
      "parameters": {
        "jsCode": "const seen = new Set();\nreturn items.map((item, index) => {\n  const email = item.json.Email ? String(item.json.Email).trim() : \"\";\n  let status = \"Invalid\";\n\n  if (email && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email)) {\n    if (!seen.has(email)) {\n      seen.add(email);\n      status = \"Valid\";\n    } else {\n      status = \"Duplicate\";\n    }\n  }\n\n  return {\n    json: {\n      email,\n      status,\n      row: item.json.row_number // keep the row from input\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
