      "parameters": {
        "jsCode": "// Get today's date without time\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\n// Loop through all incoming items\nreturn items.map(item => {\n    const dueDate = new Date(item.json[\"Review Due\"]);\n    dueDate.setHours(0, 0, 0, 0);\n\n    // Calculate difference in days\n    const diffDays = Math.floor((dueDate - today) / (1000 * 60 * 60 * 24));\n\n    // Add a new field indicating if it's 3 days before due\n    item.json.isThreeDaysBefore = (diffDays === 3);\n\n    return item;\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
