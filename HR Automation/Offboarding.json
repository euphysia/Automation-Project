    {
      "parameters": {
        "sendTo": "={{ $('Check If Employment Status is Inactive').item.json.Email }}",
        "subject": "Asset Return Reminder – Offboarding Process",
        "message": "=<p>Hi <strong>{{ $('If Asset has been Returned').item.json['Full Name'] }}</strong>,</p>      <p>       As part of the offboarding process at <strong>Lilac Grove Kindergarten</strong>, we kindly remind you to return the following company-issued items by <strong>{{ $json.formattedDate }}</strong>:     </p>      <ul>       <li>{{ $('If Asset has been Returned').item.json.Asset }}</li></ul>      <p>       Please return the items to <strong>HR Office</strong> or coordinate with us for a pickup/drop-off if needed.     </p>      <p>       If you have already returned the items, please disregard this message. Feel free to reply to this email if you need any assistance or clarification.     </p>      <p>       Thank you again for your time with us, and we wish you all the best in your next chapter.     </p>      <p>       Best regards,<br>       <strong>Ruby</strong><br>       HR Department<br>       Lilac Grove Kindergarten<br>       <a href=\"mailto:email@sample.com\">email@sample.com</a> | 012-3456789     </p>",
        "options": {
          "appendAttribution": false
        }
