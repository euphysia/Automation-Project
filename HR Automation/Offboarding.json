        "sendTo": "={{ $json.Email }}",
        "subject": "Thank You & Exit Survey – We'd Love Your Feedback",
        "message": "=<p> <img src=\"sample\" alt=\"Lilac Grove Logo\" width=\"600\" height=\"115\" style=\"display: block; margin-top: 10px;\" /> </p>\n\n<body style=\"font-family: Arial, sans-serif; color: #333; line-height: 1.6;\">\n    <p>Hi <strong>{{ $json['Full Name'] }}</strong>,</p>\n\n    <p>\n      As your time with <strong>Lilac Grove Kindergarten</strong> comes to a close, we want to thank you sincerely for all your contributions during your time with us. It’s been a pleasure having you as part of the team, and we truly appreciate the impact you've made.\n    </p>\n\n    <p>\n      To help us improve the employee experience, we’d be grateful if you could take a few minutes to complete our short <strong>exit survey</strong>:\n    </p>\n\n    <p>\n      <a href=\"https://forms.sample\" style=\"background-color: #4CAF50; color: white; padding: 10px 20px; text-decoration: none; border-radius: 4px;\">\n        Complete Exit Survey\n      </a>\n    </p>\n\n    <p>\n      We wish you all the best in your next chapter — may it be full of success, new opportunities, and growth. Stay in touch!\n    </p>\n\n    <p>\n      Warm regards,<br>\n      <strong>Ruby</strong><br>\n      HR Department<br>\n      Lilac Grove Kindergarten<br>\n      <a href=\"mailto:email@sample.com\">email@sample.com</a> | 012-3456789\n    </p>",
        "options": {
          "appendAttribution": false
        }
      },
