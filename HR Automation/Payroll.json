    {
      "parameters": {
        "jsCode": "// Get all rows from Google Sheets\nconst rows = items;\n\n// Create payslip HTML for each employee\nreturn rows.map(row => {\n    const name = row.json['Employee Name'] || '';\n    const email = row.json['Email'] || '';\n    const basic = parseFloat(row.json['Basic Salary'] || 0);\n    const allowances = parseFloat(row.json['Allowances'] || 0);\n    const otHours = parseFloat(row.json['Overtime Hours'] || 0);\n    const otRate = parseFloat(row.json['Overtime Rate'] || 0);\n    const deductions = parseFloat(row.json['Deductions'] || 0);\n\n    // Payroll calculations\n    const gross = basic + allowances + (otHours * otRate);\n    const net = gross - deductions;\n\n    // Create HTML template for payslip\n    const html = `\n    <html>\n      <body style=\"font-family: Arial; border: 1px solid #ccc; padding: 20px; width: 400px;\">\n        <h2 style=\"text-align:center;\">Payslip</h2>\n        <p><strong>Name:</strong> ${name}</p>\n        <p><strong>Basic Salary:</strong> RM ${basic.toFixed(2)}</p>\n        <p><strong>Allowances:</strong> RM ${allowances.toFixed(2)}</p>\n        <p><strong>Overtime Pay:</strong> RM ${(otHours * otRate).toFixed(2)}</p>\n        <p><strong>Deductions:</strong> RM ${deductions.toFixed(2)}</p>\n        <hr>\n        <p><strong>Gross Pay:</strong> RM ${gross.toFixed(2)}</p>\n        <p><strong>Net Pay:</strong> RM ${net.toFixed(2)}</p>\n      </body>\n    </html>\n    `;\n\n    return {\n        json: {\n            name,\n            email,\n            gross,\n            net,\n            payslipHtml: html\n        }\n    };\n});\n"
      },
