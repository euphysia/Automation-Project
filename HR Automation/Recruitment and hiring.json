      "parameters": {
        "jsCode": "const link = $json[\"Resume\"]; // Replace with your actual column name\nlet fileId = null;\n\n// Case 1: link format like /file/d/ID/\nlet match = link.match(/\\/d\\/(.*?)\\//);\nif (match && match[1]) {\n  fileId = match[1];\n}\n\n// Case 2: link format like ?id=ID\nif (!fileId) {\n  match = link.match(/id=([^&]+)/);\n  if (match && match[1]) {\n    fileId = match[1];\n  }\n}\n\nreturn [\n  {\n    json: {\n      fileId\n    }\n  }\n];\n"
      },
