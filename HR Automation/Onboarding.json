        "subject": "=New Employee IT Setup -  {{ $('Append as Successful Candidate').item.json['Full Name'] }}",
        "message": "=<!doctype html>\n<html>\n<head>\n  <p>\n<img src=\"https://drive.google.com/uc?export=view&id=1ZsBGhPFwTZunY-ogkqEpwjzYEzfEjEA0\" alt=\"Lilac Grove Logo\" width=\"600\" height=\"115\" style=\"display: block; margin-top: 10px;\" />\n</p>\n  <meta charset=\"utf-8\">\n  <title>New Employee IT Setup</title>\n</head>\n<body style=\"font-family: Arial, Helvetica, sans-serif; color:#222; line-height:1.4; margin:0; padding:20px;\">\n  <h2 style=\"color:#274746;\">New Employee IT Setup Request</h2>\n  <p>Please set up the following accounts and access for our new hire:</p>\n\n  <ul>\n    <li><strong>Full Name:</strong> {{ $('Append as Successful Candidate').item.json['Full Name'] }}</li>\n    <li><strong>Role:</strong> {{ $('Append as Successful Candidate').item.json.Position }}</li>\n    <li><strong>Department:</strong> IT</li>\n  </ul>\n\n  <h3>Required Actions</h3>\n  <ol>\n    <li>Create company email: firstname.lastname@lilacgrove.edu</li>\n    <li>Assign Role-Based Access Control (RBAC) for:\n      <ul>\n        <li>Email & Calendar</li>\n        <li>Staff Portal</li>\n        <li>Learning Management System</li>\n        <li>Shared Drives / Resources</li>\n      </ul>\n    </li>\n    <li>Send account credentials securely to HR for distribution</li>\n  </ol>\n\n  <p>Please confirm once complete.</p>\n\n  <p>Thank you,<br><strong>Ruby</strong><br>HR Department — Lilac Grove Kindergarten</p>\n</body>\n</html>\n",
        "options": {
          "appendAttribution": false
        }
      },
