    {
      "parameters": {
        "sendTo": "={{ $json.Email }}",
        "subject": "=Welcome Message - {{ $json['Full Name'] }}",
        "message": "=<html>\n<head>\n  <meta charset=\"utf-8\">\n  <title>Welcome to Lilac Grove Kindergarten</title>\n</head>\n<body style=\"font-family: Arial, Helvetica, sans-serif; color:#222; line-height:1.4; margin:0; padding:20px;\">\n  <table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\">\n    <tr>\n      <td align=\"center\">\n        <table width=\"600\" cellpadding=\"0\" cellspacing=\"0\" role=\"presentation\" style=\"border:1px solid #e6e6e6; border-radius:8px; overflow:hidden;\">\n          <tr style=\"background:#9ec5c9;\">\n            <td style=\"padding:20px; text-align:left;\">\n              <h1 style=\"margin:0; color:#274746; font-size:22px;\">Welcome to Lilac Grove Kindergarten!</h1>\n            </td>\n          </tr>\n\n          <tr>\n            <td style=\"padding:20px;\">\n              <p style=\"margin:0 0 12px 0;\">Hi <strong>{{ $json['Full Name'] }}</strong>,</p>\n\n              <p style=\"margin:0 0 12px 0;\">\n                Welcome to <strong>Lilac Grove Kindergarten</strong> — we’re delighted to have you join our family!\n              </p>\n\n              <h3 style=\"margin-top:16px; color:#274746;\">Documents we need</h3>\n              <p style=\"margin:0 0 8px 0;\">Please upload the following documents: <p>\n              <ul style=\"margin:8px 0 16px 20px;\">\n                <li>Copy of Identity Card / Passport</li>\n                <li>Bank details (for salary): Account name, bank name, account number</li>\n                <li>Medical Clearance / Vaccination Record (if applicable)</li>\n                <li>Emergency Contact Form</li>\n                <li>Teaching certificate or relevant qualifications (if applicable)</li>\n              </ul>\n\n              <p style=\"margin:0 0 12px 0;\">You can upload them securely here:</p>\n\n              <p style=\"text-align:center; margin:12px 0;\">\n                <a href=\"https://forms.gle/XYWNZnMkU3APiM3DA\" style=\"display:inline-block; padding:12px 20px; background:#6aa9a9; color:white; text-decoration:none; border-radius:6px; font-weight:600;\">\n                  Upload Documents\n                </a>\n              </p>\n\n              <hr style=\"border:none; border-top:1px solid #eee; margin:18px 0;\">\n\n              <h3 style=\"margin:0 0 8px 0; color:#274746;\">Onboarding & Training</h3>\n              <p style=\"margin:0 0 12px 0;\">\n                Mentor assigned to you is {{ $json.Manager }}. We also have a short training module to help you get started. You can access it here:\n              </p>\n              <p style=\"margin:12px 0; text-align:center;\">\n                <a href=\"https://www.notion.so/Onboarding-24c6d85553d4809b9640e729640a28fb?source=copy_link\" style=\"display:inline-block; padding:10px 16px; border:1px solid #6aa9a9; color:#274746; text-decoration:none; border-radius:6px;\">\n                  Open Onboarding Module\n                </a>\n              </p>\n\n              <p style=\"margin:0 0 12px 0;\">\n                <em>Suggestion:</em> if you prefer, you may complete the module after you’ve uploaded your documents — whichever works best for you.\n              </p>\n\n              <h4 style=\"margin-top:16px; color:#274746;\">Need help?</h4>\n              <p style=\"margin:0 0 8px 0;\">\n                If you have any questions or difficulty uploading files, contact <strong>Ruby</strong> at <a href=\"mailto:hannahrazali@gmail.com\">hannahrazali@gmail.com</a> or call 012-3456789.\n              </p>\n\n              <p style=\"margin:18px 0 0 0;\">\n                Warmly,<br>\n                <strong>Ruby</strong><br>\n                HR Manager — Lilac Grove Kindergarten\n              </p>\n\n              <p style=\"font-size:12px; color:#888; margin-top:14px;\">\n                Note: All uploaded files will be stored securely and used only for onboarding purposes.\n              </p>\n            </td>\n          </tr>\n\n          <tr style=\"background:#f6f6f6;\">\n            <td style=\"padding:12px; text-align:center; font-size:12px; color:#666;\">\n              Lilac Grove Kindergarten • 3456, Taman Bestari • 03-3456789\n            </td>\n          </tr>\n        </table>\n      </td>\n    </tr>\n  </table>\n</body>\n</html>\n",
        "options": {
          "appendAttribution": false
        }
