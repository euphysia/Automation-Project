          "__rl": true,
          "value": "gpt-4.1-mini",
          "mode": "list",
          "cachedResultName": "GPT-4.1-MINI"
        },
        "messages": {
          "values": [
            {
              "content": "=You are a cybersecurity assistant that decides if an email and its links are safe.  \nYou will receive 2 types of information:  \n\n1. Email Content:\n---\n{{ $('Gmail Trigger').item.json.text }}\n---\n\n2. URL Scan Results:\n---\n{{ $json.url_scan_results }}\n---\n\nInstructions:\n- Analyze the email content for signs of phishing, scams, or suspicious language.  \n- Analyze the URL scan results for malicious domains, phishing, malware, or other warnings.  \n- Then decide if each (email and URL) is SAFE or SUSPICIOUS.  \n\nOutput your judgement in this exact structured format:\n\n{\n  \"Email_Content\": {\n    \"Verdict\": \"SAFE or SUSPICIOUS\",\n    \"Reason\": \"short explanation\"\n  },\n  \"URL\": {\n    \"Verdict\": \"SAFE or SUSPICIOUS\",\n    \"Reason\": \"short explanation\"\n  },\n  \"Final_Judgement\": \"SAFE or SUSPICIOUS\",\n  \"Summary\": \"overall conclusion in 1–2 sentences\"\n}\n"
            }
          ]
        },
        "options": {}
      },
