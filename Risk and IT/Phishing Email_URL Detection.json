      "parameters": {
        "jsCode": "const email = $json;\n\n// Store extracted links\nlet links = [];\n\n// If email has HTML content\nif (email.textAsHtml) {\n  // Use regex to extract href values\n  const regex = /<a\\s+(?:[^>]*?\\s+)?href=([\"'])(.*?)\\1/gi;\n  let match;\n  while ((match = regex.exec(email.textAsHtml)) !== null) {\n    links.push(match[2]);\n  }\n}\n\n// Remove duplicates\nlinks = [...new Set(links)];\n\nreturn [\n  {\n    json: {\n      subject: email.subject || \"\",\n      from: email.from || \"\",\n      links: links,\n      linkCount: links.length\n    }\n  }\n];\n"
      },
