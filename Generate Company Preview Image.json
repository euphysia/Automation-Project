    {
      "parameters": {
        "jsCode": "// Loop through all incoming items\nreturn items.map(item => {\n  // Get the 'description' field (change to your actual field name if different)\n  let description = item.json.Description || \"\";\n\n  // 1️⃣ Remove all HTML tags\n  description = description.replace(/<[^>]*>/g, \"\");\n\n  // 2️⃣ Decode basic HTML entities (optional)\n  description = description\n    .replace(/&nbsp;/g, ' ')\n    .replace(/&amp;/g, '&')\n    .replace(/&quot;/g, '\"')\n    .replace(/&#39;/g, \"'\")\n    .replace(/&lt;/g, '<')\n    .replace(/&gt;/g, '>');\n\n  // Return cleaned description\n  return {\n    json: {\n      ...item.json,\n      clean_description: description.trim() // store as new field\n    }\n  };\n});\n"
      },
